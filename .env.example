NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_RESEARCH_MODEL=gpt-5
# Server-only multi-provider AI router. Never use NEXT_PUBLIC_ for these keys.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Free-tier candidates are always tried before OpenAI. Availability and billing tier depend on your provider accounts.
AI_PROVIDER_ORDER=groq,gemini,openrouter
AI_ALLOW_PAID_FALLBACK=true
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash
# Only openrouter/free or an explicit :free model is accepted.
OPENROUTER_MODEL=openrouter/free
OPENAI_FALLBACK_MODEL=
AI_GROQ_TIMEOUT_MS=20000
AI_GEMINI_TIMEOUT_MS=20000
AI_OPENROUTER_TIMEOUT_MS=20000
AI_OPENAI_TIMEOUT_MS=45000
# Local development only: simulate Groq 429 to verify Gemini fallback without calling Groq.
AI_DEV_FORCE_GROQ_429=false
LIVE_RESEARCH_ENABLED=false
VOICE_ENABLED=false
OPENAI_VOICE_MODEL=gpt-live-1
# Browser Live voice: stone (mature masculine) or cedar. Independent of phone voice.
JARVIS_BROWSER_VOICE=stone
JARVIS_LIVE_VOICE=stone
VOICE_IDLE_TIMEOUT_MS=120000
VOICE_MAX_SESSION_MINUTES=20
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the Web OAuth client authorized redirect URI.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/google/callback
# 32 random bytes encoded as base64 or 64 hex characters; server-side only.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Enabling this does not send email. Every send still needs exact owner approval.
GOOGLE_GMAIL_ENABLED=false
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_CALENDAR_WEBHOOK_BASE_URL=
GOOGLE_CALENDAR_CHANNEL_TOKEN=
RESEARCH_MAX_LEADS=50
RESEARCH_MAX_PAGES_PER_SITE=5
RESEARCH_FETCH_TIMEOUT_MS=8000
RESEARCH_MAX_CONCURRENCY=2
RESEARCH_MAX_SEARCH_QUERIES_PER_JOB=30
RESEARCH_MAX_DISCOVERY_QUERIES_PER_JOB=3
RESEARCH_MAX_CANDIDATES_PER_RUN=150
RESEARCH_MAX_DAILY_RUNS=10
RESEARCH_MAX_PROVIDER_RETRIES=1
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
JARVIS_OWNER_PHONE_NUMBER=
PUBLIC_TELEPHONY_BASE_URL=
RUN_LIVE_TWILIO_TESTS=false
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_API_SIGNATURE_SECRET=
VONAGE_PHONE_NUMBER=
VONAGE_DEVELOPMENT_TEST_MODE=false
RUN_LIVE_VONAGE_TESTS=false
