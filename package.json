{
  "name": "jarvis-business-os",
  "version": "0.6.0",
  "private": true,
  "main": "desktop/dist/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:jarvis": "node scripts/dev-jarvis.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "test:live-google": "vitest run tests-live",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "scheduler": "tsx scripts/scheduler.ts",
    "scheduler:once": "tsx scripts/scheduler.ts --once",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:package": "npm run desktop:build && electron-builder --win dir && node scripts/package-desktop.mjs",
    "postinstall": "patch-package && node scripts/ensure-next-wasm.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.4",
    "cheerio": "^1.1.2",
    "dotenv": "18.0.3",
    "framer-motion": "^12.23.12",
    "googleapis": "^181.0.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "openai": "^7.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "twilio": "^6.1.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "15.5.25",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.2",
    "patch-package": "8.0.1",
    "png-to-ico": "3.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.24"
  }
}
